generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

enum OrganizationStatus {
    ACTIVE
    INACTIVE
    SUSPENDED
    ARCHIVED
}

enum BranchStatus {
    ACTIVE
    INACTIVE
    SUSPENDED
    ARCHIVED
}

enum DepartmentStatus {
    ACTIVE
    INACTIVE
    SUSPENDED
    ARCHIVED
}

enum PositionStatus {
    ACTIVE
    INACTIVE
    SUSPENDED
    ARCHIVED
}

enum EmploymentType {
    FULL_TIME
    PART_TIME
    CONTRACTOR
    INTERN
    PROBATION
}

enum EmployeeStatus {
    ACTIVE
    INACTIVE
    TERMINATED
    SUSPENDED
    ON_LEAVE
}

enum UserStatus {
    ACTIVE
    LOCKED
    DISABLED
    PENDING_ACTIVATION
}

enum RoleStatus {
    ACTIVE
    INACTIVE
    ARCHIVED
}

enum PermissionStatus {
    ACTIVE
    INACTIVE
    ARCHIVED
}

enum UserRoleStatus {
    ACTIVE
    EXPIRED
    REVOKED
}

enum RolePermissionStatus {
    ACTIVE
    REVOKED
}

enum LoginType {
    PASSWORD
    GOOGLE
    FACEBOOK
    SSO
}

enum ShiftStatus {
    ACTIVE
    INACTIVE
    ARCHIVED
}

enum ShiftAssignmentStatus {
    ACTIVE
    CANCELLED
}

enum AttendanceStatus {
    PRESENT
    ABSENT
    ON_LEAVE
    HOLIDAY
    OFF_DAY
}

enum LeaveTypeStatus {
    ACTIVE
    INACTIVE
    ARCHIVED
}

enum LeaveRequestStatus {
    PENDING
    APPROVED
    REJECTED
    CANCELLED
}

enum HalfDayType {
    MORNING
    AFTERNOON
}

enum HolidayStatus {
    ACTIVE
    INACTIVE
    ARCHIVED
}

enum OvertimeRequestStatus {
    PENDING
    APPROVED
    REJECTED
    CANCELLED
}

enum PayrollPeriodStatus {
    OPEN
    LOCKED
    PAID
    ARCHIVED
}

enum PayrollStatus {
    PENDING
    CALCULATED
    APPROVED
    PAID
    REVERSED
    ARCHIVED
}

enum PayrollItemType {
    EARNING
    DEDUCTION
}

enum PayrollItemSource {
    SALARY
    OVERTIME
    ATTENDANCE
    LEAVE
    ALLOWANCE
    BONUS
    TAX
    INSURANCE
    MANUAL
}

enum PayrollAdjustmentType {
    ADDITION
    DEDUCTION
}

enum PayrollAdjustmentStatus {
    PENDING
    APPROVED
    REJECTED
    CANCELLED
}

enum EmployeePayComponentType {
    ALLOWANCE
    DEDUCTION
}

enum EmployeeDocumentStatus {
    ACTIVE
    INACTIVE
    EXPIRED
    ARCHIVED
}

enum EmployeeDocumentType {
    ID_CARD
    CONTRACT
    CERTIFICATE
    OTHER
}

enum AuditEntityType {
    ORGANIZATION
    BRANCH
    DEPARTMENT
    POSITION
    EMPLOYEE
    USER
    ROLE
    PERMISSION
    SHIFT
    SHIFT_ASSIGNMENT
    ATTENDANCE
    LEAVE_TYPE
    LEAVE_REQUEST
    HOLIDAY
    OVERTIME_REQUEST
    PAYROLL_PERIOD
    PAYROLL
    PAYROLL_ITEM
    PAYROLL_ADJUSTMENT
    EMPLOYEE_SALARY
    EMPLOYEE_PAY_COMPONENT
    EMPLOYEE_BANK_ACCOUNT
    EMPLOYEE_EMERGENCY_CONTACT
    EMPLOYEE_DOCUMENT
}

enum AuditAction {
    CREATE
    UPDATE
    DELETE
    APPROVE
    REJECT
    CANCEL
    LOCK
    UNLOCK
    LOGIN
    LOGOUT
}

enum EmployeeContractType {
    PROBATION
    FIXED_TERM
    INDEFINITE_TERM
}

enum EmployeeContractStatus {
    DRAFT
    ACTIVE
    TERMINATED
    EXPIRED
}

enum EmployeeTerminationType {
    RESIGNATION
    TERMINATION
    CONTRACT_END
    RETIREMENT
}

enum EmployeeTerminationStatus {
    PENDING
    APPROVED
    REJECTED
    CANCELLED
}

enum BrandStatus {
    ACTIVE
    INACTIVE
}

enum CategoryStatus {
    ACTIVE
    INACTIVE
}

enum ProductStatus {
    ACTIVE
    INACTIVE
    ARCHIVED
}

enum ProductVariantStatus {
    ACTIVE
    INACTIVE
    ARCHIVED
}

enum ProductAttributeType {
    TEXT
    NUMBER
    SELECT
}

enum WarehouseStatus {
    ACTIVE
    INACTIVE
}

enum StockMovementType {
    PURCHASE
    SALE
    TRANSFER_IN
    TRANSFER_OUT
    ADJUSTMENT
    RETURN_IN
    RETURN_OUT
}

enum ReferenceType {
    PURCHASE_ORDER
    ORDER
    TRANSFER
}

enum StockTransferStatus {
    DRAFT
    PENDING
    APPROVED
    IN_TRANSIT
    COMPLETED
    CANCELLED
}

enum PurchaseOrderStatus {
    DRAFT
    ORDERED
    PARTIALLY_RECEIVED
    RECEIVED
    CANCELLED
}

enum SupplierStatus {
    ACTIVE
    INACTIVE
}

model Organization {
    id        String             @id @default(uuid())
    code      String             @unique
    name      String
    taxCode   String?            @unique
    phone     String?
    email     String?            @unique
    // logoMediaId String?
    website   String?
    timezone  String             @default("Asia/Ho_Chi_Minh")
    currency  String             @default("VND")
    status    OrganizationStatus @default(ACTIVE)
    createdAt DateTime           @default(now())
    updatedAt DateTime           @updatedAt
    deletedAt DateTime?
    // @@index([createdAt])
    // @@index([deletedAt])

    branches Branch[]

    @@index([status])
}

model Branch {
    id             String       @id @default(uuid())
    organizationId String
    code           String
    name           String
    phone          String?
    email          String?
    taxCode        String?
    address        String
    latitude       Decimal?
    longitude      Decimal?
    openTime       String?
    closeTime      String?
    timezone       String       @default("Asia/Ho_Chi_Minh")
    status         BranchStatus @default(ACTIVE)
    createdAt      DateTime     @default(now())
    updatedAt      DateTime     @updatedAt
    deletedAt      DateTime?

    organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
    departments    Department[]
    employees      Employee[]
    shifts         Shift[]
    holidays       Holiday[]
    payrollPeriods PayrollPeriod[]
    warehouses     Warehouse[]

    @@unique([organizationId, code])
}

model Department {
    id          String           @id @default(uuid())
    branchId    String
    code        String
    name        String
    description String?
    status      DepartmentStatus @default(ACTIVE)
    createdAt   DateTime         @default(now())
    updatedAt   DateTime         @updatedAt
    deletedAt   DateTime?

    branch    Branch     @relation(fields: [branchId], references: [id], onDelete: Restrict)
    positions Position[]
    employees Employee[]

    @@unique([branchId, code])
}

model Position {
    id           String         @id @default(uuid())
    departmentId String
    code         String
    name         String
    level        Int
    description  String?
    status       PositionStatus @default(ACTIVE)
    createdAt    DateTime       @default(now())
    updatedAt    DateTime       @updatedAt
    deletedAt    DateTime?

    department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
    employees  Employee[]

    @@unique([departmentId, code])
}

model Employee {
    id              String         @id @default(uuid())
    branchId        String
    departmentId    String
    positionId      String
    managerId       String?
    employeeCode    String
    firstName       String
    lastName        String
    fullName        String
    email           String?        @unique
    phone           String?        @unique
    dateOfBirth     DateTime?      @db.Date
    hireDate        DateTime       @db.Date
    terminationDate DateTime?      @db.Date
    employmentType  EmploymentType
    status          EmployeeStatus @default(ACTIVE)
    createdAt       DateTime       @default(now())
    updatedAt       DateTime       @updatedAt
    deletedAt       DateTime?

    branch                      Branch                     @relation(fields: [branchId], references: [id], onDelete: Restrict)
    position                    Position                   @relation(fields: [positionId], references: [id], onDelete: Restrict)
    department                  Department                 @relation(fields: [departmentId], references: [id], onDelete: Restrict)
    manager                     Employee?                  @relation("EmployeeManager", fields: [managerId], references: [id])
    subordinates                Employee[]                 @relation("EmployeeManager")
    user                        User?
    shiftAssignments            ShiftAssignment[]          @relation("EmployeeShiftAssignment")
    assignedShiftAssignments    ShiftAssignment[]          @relation("AssignedByEmployee")
    attendances                 Attendance[]
    leaveBalances               LeaveBalance[]
    leaveRequests               LeaveRequest[]             @relation("EmployeeRequest")
    approvedLeaveRequests       LeaveRequest[]             @relation("EmployeeApprove")
    cancelLeaveRequests         LeaveRequest[]             @relation("CancelledByEmployee")
    overTimeRequests            OvertimeRequest[]          @relation("EmployeeOvertimeRequest")
    approvedOvertimeRequests    OvertimeRequest[]          @relation("EmployeeOvertimeApprove")
    canceledOvertimeRequests    OvertimeRequest[]          @relation("EmployeeOvertimeCancel")
    lockedPayrollPeriods        PayrollPeriod[]
    payrolls                    Payroll[]                  @relation("EmployeePayroll")
    approvedPayrolls            Payroll[]                  @relation("EmployeeApprovePayroll")
    payrollAdjustments          PayrollAdjustment[]        @relation("EmployeePayrollAdjustment")
    approved                    PayrollAdjustment[]        @relation("EmployeeApprovePayrollAdjustment")
    employeeSalaries            EmployeeSalary[]
    employeeAllowances          EmployeePayComponent[]
    employeeBankAccounts        EmployeeBankAccount[]
    employeeEmergencyContacts   EmployeeEmergencyContact[]
    employeeDocuments           EmployeeDocument[]
    employeeContracts           EmployeeContract[]
    employeeTerminations        EmployeeTermination[]      @relation("EmployeeTermination")
    employeeApproveTerminations EmployeeTermination[]      @relation("EmployeeApproveTermination")

    @@unique([branchId, employeeCode])
    @@index([departmentId])
    @@index([positionId])
    @@index([managerId])
    @@index([status])
}

model User {
    id                String     @id @default(uuid())
    employeeId        String     @unique
    username          String     @unique
    email             String     @unique
    passwordHash      String
    failedLoginCount  Int        @default(0)
    lastLoginAt       DateTime?
    passwordChangedAt DateTime?
    lockedUntil       DateTime?
    status            UserStatus @default(PENDING_ACTIVATION)
    createdAt         DateTime   @default(now())
    updatedAt         DateTime   @updatedAt
    deletedAt         DateTime?

    employee                      Employee                 @relation(fields: [employeeId], references: [id], onDelete: Restrict)
    userRoles                     UserRole[]               @relation("UserRoles")
    assignedRoles                 UserRole[]               @relation("AssignedUserRoles")
    revokedRoles                  UserRole[]               @relation("RevokedUserRoles")
    assignedPermission            RolePermission[]         @relation("AssignedRolePermissions")
    revokedPermission             RolePermission[]         @relation("RevokedRolePermissions")
    refreshTokens                 RefreshToken[]           @relation("UserRefreshToken")
    revokeRefreshTokens           RefreshToken[]           @relation("RevokedRefreshTokenUser")
    loginHistories                LoginHistory[]
    passwordResetTokens           PasswordResetToken[]
    revokedPasswordReset          PasswordResetToken[]     @relation("RevokedPasswordResetTokenUser")
    emailVerificationTokens       EmailVerificationToken[]
    revokedEmailVerificationToken EmailVerificationToken[] @relation("RevokedEmailVerificationTokens")
    stockMovements                StockMovement[]
    requestStockTransfers         StockTransfer[]          @relation("UserRequest")
    approveStockTransfers         StockTransfer[]          @relation("UserApprove")
    purchaseOrders                PurchaseOrder[]

    @@index([status])
    @@index([lastLoginAt])
}

model Role {
    id              String           @id @default(uuid())
    code            String           @unique
    name            String
    description     String?
    isSystem        Boolean          @default(false)
    status          RoleStatus       @default(ACTIVE)
    createdAt       DateTime         @default(now())
    updatedAt       DateTime         @updatedAt
    deletedAt       DateTime?
    userRoles       UserRole[]
    userPermissions RolePermission[]

    @@index([status])
}

model Permission {
    id              String           @id @default(uuid())
    code            String           @unique
    permissionGroup String
    module          String
    action          String
    name            String
    description     String?
    isSystem        Boolean          @default(false)
    status          PermissionStatus @default(ACTIVE)
    createdAt       DateTime         @default(now())
    updatedAt       DateTime         @updatedAt
    deletedAt       DateTime?
    userPermissions RolePermission[]

    @@unique([module, action])
    @@index([permissionGroup])
    @@index([status])
    @@index([module])
}

model UserRole {
    id         String         @id @default(uuid())
    userId     String
    roleId     String
    assignedBy String?
    assignedAt DateTime       @default(now())
    expiredAt  DateTime?
    reason     String?
    status     UserRoleStatus @default(ACTIVE)
    revokedAt  DateTime?
    revokedBy  String?
    createdAt  DateTime       @default(now())
    updatedAt  DateTime       @updatedAt
    deletedAt  DateTime?

    user           User  @relation("UserRoles", fields: [userId], references: [id], onDelete: Restrict)
    role           Role  @relation(fields: [roleId], references: [id], onDelete: Restrict)
    assignedByUser User? @relation("AssignedUserRoles", fields: [assignedBy], references: [id])
    revokedByUser  User? @relation("RevokedUserRoles", fields: [revokedBy], references: [id])

    @@index([userId])
    @@index([roleId])
    @@index([status])
    @@index([assignedBy])
    @@index([revokedBy])
    @@index([expiredAt])
}

model RolePermission {
    id           String               @id @default(uuid())
    roleId       String
    permissionId String
    assignedAt   DateTime             @default(now())
    assignedBy   String?
    revokedAt    DateTime?
    revokedBy    String?
    reason       String?
    status       RolePermissionStatus @default(ACTIVE)
    createdAt    DateTime             @default(now())
    updatedAt    DateTime             @updatedAt
    deletedAt    DateTime?

    role           Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
    permission     Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)
    assignedByUser User?      @relation("AssignedRolePermissions", fields: [assignedBy], references: [id])
    revokedByUser  User?      @relation("RevokedRolePermissions", fields: [revokedBy], references: [id])

    @@index([roleId])
    @@index([permissionId])
    @@index([status])
    @@index([assignedBy])
    @@index([revokedBy])
}

model RefreshToken {
    id            String    @id @default(uuid())
    userId        String
    tokenHash     String    @unique
    deviceId      String?
    deviceName    String?
    ipAddress     String?
    userAgent     String?
    expiresAt     DateTime
    revokedAt     DateTime?
    revokedBy     String?
    revokedReason String?
    createdAt     DateTime  @default(now())
    updatedAt     DateTime  @updatedAt

    user          User  @relation("UserRefreshToken", fields: [userId], references: [id], onDelete: Restrict)
    revokedByUser User? @relation("RevokedRefreshTokenUser", fields: [revokedBy], references: [id], onDelete: Restrict)

    @@index([userId])
    @@index([expiresAt])
}

model LoginHistory {
    id           String    @id @default(uuid())
    userId       String?
    username     String
    loginType    LoginType
    success      Boolean
    failedReason String?
    ipAddress    String?
    userAgent    String?
    deviceId     String?
    deviceName   String?
    createdAt    DateTime  @default(now())

    user User? @relation(fields: [userId], references: [id], onDelete: Restrict)

    @@index([userId])
    @@index([createdAt])
    @@index([success])
}

model PasswordResetToken {
    id            String    @id @default(uuid())
    userId        String
    tokenHash     String    @unique
    expiresAt     DateTime
    usedAt        DateTime?
    revokedAt     DateTime?
    revokedBy     String?
    revokedReason String?
    createdAt     DateTime  @default(now())

    user          User  @relation(fields: [userId], references: [id], onDelete: Restrict)
    revokedByUser User? @relation("RevokedPasswordResetTokenUser", fields: [revokedBy], references: [id], onDelete: Restrict)

    @@index([userId])
    @@index([expiresAt])
}

model EmailVerificationToken {
    id            String    @id @default(uuid())
    userId        String
    email         String
    tokenHash     String    @unique
    expiresAt     DateTime
    usedAt        DateTime?
    revokedAt     DateTime?
    revokedBy     String?
    revokedReason String?
    createdAt     DateTime  @default(now())

    user          User  @relation(fields: [userId], references: [id], onDelete: Restrict)
    revokedByUser User? @relation("RevokedEmailVerificationTokens", fields: [revokedBy], references: [id], onDelete: Restrict)

    @@index([userId])
    @@index([expiresAt])
}

model Shift {
    id                     String      @id @default(uuid())
    branchId               String
    code                   String
    name                   String
    startTime              String
    endTime                String
    breakMinutes           Int
    lateGraceMinutes       Int
    earlyLeaveGraceMinutes Int
    isCrossDay             Boolean     @default(false)
    description            String?
    status                 ShiftStatus @default(ACTIVE)
    createdAt              DateTime    @default(now())
    updatedAt              DateTime    @updatedAt
    deletedAt              DateTime?

    branch           Branch            @relation(fields: [branchId], references: [id], onDelete: Restrict)
    shiftAssignments ShiftAssignment[]

    @@unique([branchId, code])
    @@index([status])
}

model ShiftAssignment {
    id          String                @id @default(uuid())
    employeeId  String
    shiftId     String
    workingDate DateTime              @db.Date
    assignedBy  String?
    note        String?
    status      ShiftAssignmentStatus @default(ACTIVE)
    createdAt   DateTime              @default(now())
    updatedAt   DateTime              @updatedAt
    deletedAt   DateTime?

    shift              Shift        @relation(fields: [shiftId], references: [id], onDelete: Restrict)
    employee           Employee     @relation("EmployeeShiftAssignment", fields: [employeeId], references: [id], onDelete: Restrict)
    assignedByEmployee Employee?    @relation("AssignedByEmployee", fields: [assignedBy], references: [id], onDelete: Restrict)
    attendances        Attendance[]

    @@unique([employeeId, workingDate, shiftId])
    @@index([status])
    @@index([assignedBy])
    @@index([workingDate])
}

model Attendance {
    id                String           @id @default(uuid())
    shiftAssignmentId String
    employeeId        String
    checkInAt         DateTime?
    checkOutAt        DateTime?
    checkInMethod     String?
    checkOutMethod    String?
    checkInIp         String?
    checkOutIp        String?
    checkInLatitude   Decimal?
    checkInLongitude  Decimal?
    checkOutLatitude  Decimal?
    checkOutLongitude Decimal?
    workedMinutes     Int              @default(0)
    workingDate       DateTime         @db.Date
    lateMinutes       Int              @default(0)
    earlyLeaveMinutes Int              @default(0)
    overtimeMinutes   Int              @default(0)
    attendanceStatus  AttendanceStatus @default(PRESENT)
    createdAt         DateTime         @default(now())
    updatedAt         DateTime         @updatedAt
    deletedAt         DateTime?

    shiftAssignment  ShiftAssignment   @relation(fields: [shiftAssignmentId], references: [id], onDelete: Restrict)
    employee         Employee          @relation(fields: [employeeId], references: [id], onDelete: Restrict)
    overtimeRequests OvertimeRequest[]

    @@unique([shiftAssignmentId])
    @@index([workingDate])
    @@index([attendanceStatus])
    @@index([employeeId])
    @@index([employeeId, workingDate])
}

model LeaveType {
    id                   String          @id @default(uuid())
    code                 String          @unique
    name                 String
    description          String?
    defaultDays          Int             @default(0)
    isPaid               Boolean         @default(true)
    requireApproval      Boolean         @default(true)
    allowHalfDay         Boolean         @default(true)
    allowCarryOver       Boolean         @default(false)
    maxCarryOverDays     Int             @default(0)
    carryOverExpiryDay   Int?
    carryOverExpiryMonth Int?
    status               LeaveTypeStatus @default(ACTIVE)
    createdAt            DateTime        @default(now())
    updatedAt            DateTime        @updatedAt
    deletedAt            DateTime?
    leaveBalances        LeaveBalance[]
    leaveRequests        LeaveRequest[]

    @@index([status])
}

model LeaveBalance {
    id            String         @id @default(uuid())
    employeeId    String
    leaveTypeId   String
    year          Int
    allocatedDays Float          @default(0)
    carryOverDays Float          @default(0)
    adjustedDays  Float          @default(0)
    usedDays      Float          @default(0)
    remainingDays Float          @default(0)
    createdAt     DateTime       @default(now())
    updatedAt     DateTime       @updatedAt
    deletedAt     DateTime?
    leaveRequests LeaveRequest[]

    employee  Employee  @relation(fields: [employeeId], references: [id], onDelete: Restrict)
    leaveType LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)

    @@unique([employeeId, leaveTypeId, year])
    @@index([employeeId])
    @@index([leaveTypeId])
    @@index([year])
}

model LeaveRequest {
    id              String             @id @default(uuid())
    employeeId      String
    leaveTypeId     String
    approverId      String?
    leaveBalanceId  String
    fromDate        DateTime           @db.Date
    toDate          DateTime           @db.Date
    requestedDays   Float
    isHalfDay       Boolean            @default(false)
    halfDayType     HalfDayType?
    reason          String
    rejectedReason  String?
    approvedAt      DateTime?
    rejectedAt      DateTime?
    cancelledAt     DateTime?
    cancelledBy     String?
    cancelledReason String?
    status          LeaveRequestStatus @default(PENDING)
    createdAt       DateTime           @default(now())
    updatedAt       DateTime           @updatedAt
    deletedAt       DateTime?

    employee            Employee     @relation("EmployeeRequest", fields: [employeeId], references: [id], onDelete: Restrict)
    approver            Employee?    @relation("EmployeeApprove", fields: [approverId], references: [id], onDelete: Restrict)
    cancelledByEmployee Employee?    @relation("CancelledByEmployee", fields: [cancelledBy], references: [id], onDelete: Restrict)
    leaveType           LeaveType    @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)
    leaveBalance        LeaveBalance @relation(fields: [leaveBalanceId], references: [id], onDelete: Restrict)

    @@index([employeeId])
    @@index([approverId])
    @@index([leaveTypeId])
    @@index([status])
    @@index([fromDate])
    @@index([toDate])
}

model Holiday {
    id          String        @id @default(uuid())
    branchId    String?
    code        String
    name        String
    description String?
    fromDate    DateTime      @db.Date
    toDate      DateTime      @db.Date
    year        Int
    isPaid      Boolean       @default(true)
    status      HolidayStatus @default(ACTIVE)
    createdAt   DateTime      @default(now())
    updatedAt   DateTime      @updatedAt
    deletedAt   DateTime?

    branch Branch? @relation(fields: [branchId], references: [id], onDelete: Restrict)

    @@unique([branchId, code, year])
    @@index([status])
    @@index([fromDate])
    @@index([toDate])
    @@index([year])
    @@index([branchId])
}

model OvertimeRequest {
    id                 String                @id @default(uuid())
    attendanceId       String
    employeeId         String
    approverId         String?
    workingDate        DateTime              @db.Date
    startTime          DateTime
    endTime            DateTime
    requestedMinutes   Int
    approvedMinutes    Int                   @default(0)
    overtimeMultiplier Float
    reason             String
    approvedAt         DateTime?
    rejectedAt         DateTime?
    rejectedReason     String?
    cancelledAt        DateTime?
    cancelledBy        String?
    cancelledReason    String?
    status             OvertimeRequestStatus @default(PENDING)
    createdAt          DateTime              @default(now())
    updatedAt          DateTime              @updatedAt
    deletedAt          DateTime?

    attendance              Attendance @relation(fields: [attendanceId], references: [id], onDelete: Restrict)
    employeeOvertimeRequest Employee   @relation("EmployeeOvertimeRequest", fields: [employeeId], references: [id], onDelete: Restrict)
    approver                Employee?  @relation("EmployeeOvertimeApprove", fields: [approverId], references: [id], onDelete: Restrict)
    cancelledByEmployee     Employee?  @relation("EmployeeOvertimeCancel", fields: [cancelledBy], references: [id], onDelete: Restrict)

    @@index([employeeId])
    @@index([approverId])
    @@index([status])
    @@index([workingDate])
    @@index([attendanceId])
}

model PayrollPeriod {
    id          String              @id @default(uuid())
    branchId    String
    code        String
    name        String
    year        Int
    month       Int
    periodStart DateTime            @db.Date
    periodEnd   DateTime            @db.Date
    lockedAt    DateTime?
    lockedBy    String?
    paidAt      DateTime?
    status      PayrollPeriodStatus @default(OPEN)
    createdAt   DateTime            @default(now())
    updatedAt   DateTime            @updatedAt
    deletedAt   DateTime?

    branch           Branch    @relation(fields: [branchId], references: [id], onDelete: Restrict)
    lockedByEmployee Employee? @relation(fields: [lockedBy], references: [id], onDelete: Restrict)
    payrolls         Payroll[]

    @@unique([branchId, year, month])
    @@index([status])
    @@index([paidAt])
}

model Payroll {
    id              String        @id @default(uuid())
    payrollPeriodId String
    employeeId      String
    baseSalary      Decimal
    totalEarnings   Decimal
    totalDeductions Decimal
    grossSalary     Decimal
    netSalary       Decimal
    workingDays     Int
    paidLeaveDays   Int
    unpaidLeaveDays Int
    overtimeMinutes Int
    overtimeAmount  Decimal
    status          PayrollStatus @default(PENDING)
    calculatedAt    DateTime?
    approvedAt      DateTime?
    approvedBy      String?
    paidAt          DateTime?
    createdAt       DateTime      @default(now())
    updatedAt       DateTime      @updatedAt
    deletedAt       DateTime?

    payrollPeriod      PayrollPeriod       @relation(fields: [payrollPeriodId], references: [id], onDelete: Restrict)
    employee           Employee            @relation("EmployeePayroll", fields: [employeeId], references: [id], onDelete: Restrict)
    approvedByEmployee Employee?           @relation("EmployeeApprovePayroll", fields: [approvedBy], references: [id], onDelete: Restrict)
    payrollItems       PayrollItem[]
    payrollAdjustments PayrollAdjustment[]
    payrollTaxes       PayrollTax[]

    @@unique([payrollPeriodId, employeeId])
    @@index([status])
    @@index([employeeId])
}

model PayrollItem {
    id          String            @id @default(uuid())
    payrollId   String
    type        PayrollItemType
    code        String
    name        String
    description String?
    amount      Decimal
    quantity    Decimal?
    unitAmount  Decimal?
    source      PayrollItemSource
    reason      String?
    createdAt   DateTime          @default(now())
    updatedAt   DateTime          @updatedAt
    deletedAt   DateTime?

    payroll Payroll @relation(fields: [payrollId], references: [id], onDelete: Restrict)

    @@index([payrollId])
    @@index([type])
    @@index([source])
    @@index([code])
}

model PayrollAdjustment {
    id         String                  @id @default(uuid())
    payrollId  String
    employeeId String
    type       PayrollAdjustmentType
    amount     Decimal
    reason     String
    approvedBy String?
    approvedAt DateTime?
    status     PayrollAdjustmentStatus @default(PENDING)
    createdAt  DateTime                @default(now())
    updatedAt  DateTime                @updatedAt
    deletedAt  DateTime?

    payroll  Payroll   @relation(fields: [payrollId], references: [id], onDelete: Restrict)
    employee Employee  @relation("EmployeePayrollAdjustment", fields: [employeeId], references: [id], onDelete: Restrict)
    approver Employee? @relation("EmployeeApprovePayrollAdjustment", fields: [approvedBy], references: [id], onDelete: Restrict)
}

model EmployeeSalary {
    id            String    @id @default(uuid())
    employeeId    String
    baseSalary    Decimal
    effectiveFrom DateTime
    createdAt     DateTime  @default(now())
    updatedAt     DateTime  @updatedAt
    deletedAt     DateTime?

    employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

    @@index([employeeId])
    @@index([effectiveFrom])
}

model EmployeePayComponent {
    id            String                   @id @default(uuid())
    employeeId    String
    code          String
    type          EmployeePayComponentType
    amount        Decimal
    effectiveFrom DateTime
    createdAt     DateTime                 @default(now())
    updatedAt     DateTime                 @updatedAt
    deletedAt     DateTime?

    employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

    @@index([employeeId, code])
    @@index([effectiveFrom])
}

model PayrollTax {
    id            String    @id @default(uuid())
    payrollId     String
    taxableIncome Decimal
    taxAmount     Decimal
    createdAt     DateTime  @default(now())
    updatedAt     DateTime  @updatedAt
    deletedAt     DateTime?

    payroll Payroll @relation(fields: [payrollId], references: [id], onDelete: Restrict)

    @@unique([payrollId])
}

model EmployeeBankAccount {
    id            String    @id @default(uuid())
    employeeId    String
    bankCode      String
    accountNumber String
    accountName   String
    isPrimary     Boolean   @default(false)
    effectiveFrom DateTime
    createdAt     DateTime  @default(now())
    updatedAt     DateTime  @updatedAt
    deletedAt     DateTime?

    employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

    @@unique([employeeId, bankCode, accountNumber])
    @@index([employeeId])
}

model EmployeeEmergencyContact {
    id           String    @id @default(uuid())
    employeeId   String
    name         String
    relationship String
    phone        String
    isPrimary    Boolean   @default(false)
    createdAt    DateTime  @default(now())
    updatedAt    DateTime  @updatedAt
    deletedAt    DateTime?

    employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

    @@unique([employeeId, relationship])
}

model EmployeeDocument {
    id             String                 @id @default(uuid())
    employeeId     String
    documentType   EmployeeDocumentType
    filePath       String
    documentNumber String?
    issueDate      DateTime?
    expiryDate     DateTime?
    fileName       String
    status         EmployeeDocumentStatus @default(ACTIVE)
    createdAt      DateTime               @default(now())
    updatedAt      DateTime               @updatedAt
    deletedAt      DateTime?

    employee          Employee           @relation(fields: [employeeId], references: [id], onDelete: Restrict)
    employeeContracts EmployeeContract[]

    @@index([employeeId])
    @@index([documentType])
    @@index([status])
}

model AuditLog {
    id         String          @id @default(uuid())
    entityType AuditEntityType
    entityId   String
    action     AuditAction
    changedBy  String?
    oldValue   Json?
    newValue   Json?
    ipAddress  String?
    userAgent  String?
    createdAt  DateTime        @default(now())

    @@index([entityType, entityId])
    @@index([action])
}

model EmployeeContract {
    id             String                 @id @default(uuid())
    employeeId     String
    contractNumber String?
    contractType   EmployeeContractType
    startDate      DateTime
    endDate        DateTime?
    status         EmployeeContractStatus @default(DRAFT)
    baseSalary     Decimal
    documentId     String?
    createdAt      DateTime               @default(now())
    updatedAt      DateTime               @updatedAt
    deletedAt      DateTime?

    employee Employee          @relation(fields: [employeeId], references: [id], onDelete: Restrict)
    document EmployeeDocument? @relation(fields: [documentId], references: [id], onDelete: Restrict)

    @@unique([employeeId, contractType, startDate, endDate])
    @@index([status])
}

model EmployeeTermination {
    id              String                    @id @default(uuid())
    employeeId      String
    terminationDate DateTime
    reason          String?
    type            EmployeeTerminationType
    status          EmployeeTerminationStatus @default(PENDING)
    note            String?
    approvedAt      DateTime?
    approvedBy      String?

    employeeTermination Employee  @relation("EmployeeTermination", fields: [employeeId], references: [id], onDelete: Restrict)
    employeeApprove     Employee? @relation("EmployeeApproveTermination", fields: [approvedBy], references: [id], onDelete: Restrict)

    @@index([employeeId])
    @@index([status])
    @@index([type])
    @@index([terminationDate])
}

model Brand {
    id          String      @id @default(uuid())
    code        String      @unique
    name        String
    description String?
    status      BrandStatus @default(ACTIVE)
    logoUrl     String?
    createdAt   DateTime    @default(now())
    updatedAt   DateTime    @updatedAt
    deletedAt   DateTime?
    products    Product[]

    @@index([status])
}

model Category {
    id          String         @id @default(uuid())
    code        String         @unique
    name        String
    parentId    String?
    description String?
    status      CategoryStatus @default(ACTIVE)
    createdAt   DateTime       @default(now())
    updatedAt   DateTime       @updatedAt
    deletedAt   DateTime?

    parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
    children Category[] @relation("CategoryHierarchy")
    products Product[]

    @@index([parentId])
    @@index([status])
}

model Product {
    id          String        @id @default(uuid())
    brandId     String
    categoryId  String
    name        String
    code        String        @unique
    description String?
    status      ProductStatus @default(ACTIVE)
    createdAt   DateTime      @default(now())
    updatedAt   DateTime      @updatedAt
    deletedAt   DateTime?

    brand           Brand            @relation(fields: [brandId], references: [id], onDelete: Restrict)
    category        Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
    productVariants ProductVariant[]
    productImages   ProductImage[]

    @@index([brandId])
    @@index([categoryId])
    @@index([status])
}

model ProductVariant {
    id                      String                    @id @default(uuid())
    productId               String
    sku                     String                    @unique
    name                    String
    barcode                 String?
    costPrice               Decimal
    sellingPrice            Decimal
    status                  ProductVariantStatus      @default(ACTIVE)
    createdAt               DateTime                  @default(now())
    updatedAt               DateTime                  @updatedAt
    deletedAt               DateTime?
    product                 Product                   @relation(fields: [productId], references: [id], onDelete: Restrict)
    productVarianAttributes ProductVariantAttribute[]
    stocks                  Stock[]
    stockTransferItems      StockTransferItem[]
    purchaseOrderItems      PurchaseOrderItem[]

    @@index([productId])
    @@index([barcode])
    @@index([status])
}

model ProductImage {
    id        String    @id @default(uuid())
    productId String
    filePath  String
    isPrimary Boolean   @default(false)
    fileName  String
    sortOrder Int       @default(0)
    altText   String?
    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt
    deletedAt DateTime?

    product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

    @@index([productId])
}

model ProductAttribute {
    id                       String                    @id @default(uuid())
    code                     String                    @unique
    name                     String
    type                     ProductAttributeType      @default(SELECT)
    createdAt                DateTime                  @default(now())
    updatedAt                DateTime                  @updatedAt
    deletedAt                DateTime?
    productVariantAttributes ProductVariantAttribute[]

    @@index([name])
}

model ProductVariantAttribute {
    id          String    @id @default(uuid())
    variantId   String
    attributeId String
    value       String
    createdAt   DateTime  @default(now())
    updatedAt   DateTime  @updatedAt
    deletedAt   DateTime?

    variant   ProductVariant   @relation(fields: [variantId], references: [id], onDelete: Restrict)
    attribute ProductAttribute @relation(fields: [attributeId], references: [id], onDelete: Restrict)

    @@unique([variantId, attributeId])
}

model Warehouse {
    id          String          @id @default(uuid())
    branchId    String
    code        String
    name        String
    description String?
    status      WarehouseStatus @default(ACTIVE)
    createdAt   DateTime        @default(now())
    updatedAt   DateTime        @updatedAt
    deletedAt   DateTime?

    branch             Branch          @relation(fields: [branchId], references: [id], onDelete: Restrict)
    stocks             Stock[]
    transfersFromStock StockTransfer[] @relation("FromWarehouse")
    transfersToStock   StockTransfer[] @relation("ToWarehouse")
    purchaseOrders     PurchaseOrder[]

    @@unique([branchId, code])
    @@index([status])
    @@index([name])
}

model Stock {
    id               String    @id @default(uuid())
    warehouseId      String
    variantId        String
    quantity         Int       @default(0)
    reservedQuantity Int       @default(0)
    createdAt        DateTime  @default(now())
    updatedAt        DateTime  @updatedAt
    deletedAt        DateTime?

    warehouse      Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
    variant        ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Restrict)
    stockMovements StockMovement[]

    @@unique([warehouseId, variantId])
}

model StockMovement {
    id            String            @id @default(uuid())
    stockId       String
    type          StockMovementType @default(PURCHASE)
    quantity      Int
    referenceType ReferenceType?
    referenceId   String?
    note          String?
    balanceAfter  Int
    createdBy     String

    stock Stock @relation(fields: [stockId], references: [id], onDelete: Restrict)
    user  User  @relation(fields: [createdBy], references: [id], onDelete: Restrict)

    @@index([type])
    @@index([referenceType])
    @@index([stockId])
}

model StockTransfer {
    id              String              @id @default(uuid())
    fromWarehouseId String
    toWarehouseId   String
    status          StockTransferStatus @default(DRAFT)
    code            String              @unique
    requestedBy     String
    approvedBy      String?
    approvedAt      DateTime?
    completedAt     DateTime?
    note            String?
    createdAt       DateTime            @default(now())
    updatedAt       DateTime            @updatedAt
    deletedAt       DateTime?

    fromWarehouse      Warehouse           @relation("FromWarehouse", fields: [fromWarehouseId], references: [id], onDelete: Restrict)
    toWarehouse        Warehouse           @relation("ToWarehouse", fields: [toWarehouseId], references: [id], onDelete: Restrict)
    userRequest        User?               @relation("UserRequest", fields: [requestedBy], references: [id], onDelete: Restrict)
    userApprove        User?               @relation("UserApprove", fields: [approvedBy], references: [id], onDelete: Restrict)
    stockTransferItems StockTransferItem[]

    @@index([status])
    @@index([fromWarehouseId])
    @@index([toWarehouseId])
}

model StockTransferItem {
    id               String    @id @default(uuid())
    stockTransferId  String
    variantId        String
    quantity         Int
    receivedQuantity Int       @default(0)
    createdAt        DateTime  @default(now())
    updatedAt        DateTime  @updatedAt
    deletedAt        DateTime?

    stockTransfer StockTransfer  @relation(fields: [stockTransferId], references: [id], onDelete: Restrict)
    variant       ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

    @@unique([stockTransferId, variantId])
}

model Supplier {
    id             String          @id @default(uuid())
    code           String          @unique
    name           String
    status         SupplierStatus  @default(ACTIVE)
    taxCode        String?         @unique
    phone          String?
    email          String?
    address        String?
    contactName    String?
    note           String?
    createdAt      DateTime        @default(now())
    updatedAt      DateTime        @updatedAt
    deletedAt      DateTime?
    purchaseOrders PurchaseOrder[]

    @@index([status])
}

model PurchaseOrder {
    id          String              @id @default(uuid())
    warehouseId String
    supplierId  String
    status      PurchaseOrderStatus @default(DRAFT)
    code        String              @unique
    orderedAt   DateTime?
    expectedAt  DateTime?
    receivedAt  DateTime?
    createdBy   String
    note        String?
    createdAt   DateTime            @default(now())
    updatedAt   DateTime            @updatedAt
    deletedAt   DateTime?

    warehouse          Warehouse           @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
    supplier           Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
    user               User?               @relation(fields: [createdBy], references: [id], onDelete: Restrict)
    purchaseOrderItems PurchaseOrderItem[]

    @@index([status])
    @@index([orderedAt])
    @@index([warehouseId])
    @@index([supplierId])
}

model PurchaseOrderItem {
    id               String  @id @default(uuid())
    purchaseOrderId  String
    variantId        String
    quantity         Int
    receivedQuantity Int     @default(0)
    unitCost         Decimal
    note             String?

    purchaseOrder PurchaseOrder  @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
    variant       ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

    @@unique([purchaseOrderId, variantId])
}
