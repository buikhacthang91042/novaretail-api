generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

enum OrganizationStatus {
    ACTIVE
    INACTIVE
    SUSPENDED
    ARCHIVED
}

enum BranchStatus {
    ACTIVE
    INACTIVE
    SUSPENDED
    ARCHIVED
}

enum DepartmentStatus {
    ACTIVE
    INACTIVE
    SUSPENDED
    ARCHIVED
}

enum PositionStatus {
    ACTIVE
    INACTIVE
    SUSPENDED
    ARCHIVED
}

enum EmploymentType {
    FULL_TIME
    PART_TIME
    CONTRACTOR
    INTERN
    PROBATION
}

enum EmployeeStatus {
    ACTIVE
    INACTIVE
    TERMINATED
    SUSPENDED
    ON_LEAVE
}

enum UserStatus {
    ACTIVE
    LOCKED
    DISABLED
    PENDING_ACTIVATION
}

enum RoleStatus {
    ACTIVE
    INACTIVE
    ARCHIVED
}

enum PermissionStatus {
    ACTIVE
    INACTIVE
    ARCHIVED
}

enum UserRoleStatus {
    ACTIVE
    EXPIRED
    REVOKED
}

enum RolePermissionStatus {
    ACTIVE
    REVOKED
}

enum LoginType {
    PASSWORD
    GOOGLE
    FACEBOOK
    SSO
}

enum ShiftStatus {
    ACTIVE
    INACTIVE
    ARCHIVED
}

enum ShiftAssignmentStatus {
    ACTIVE
    CANCELLED
}

enum AttendanceStatus {
    PRESENT
    ABSENT
    ON_LEAVE
    HOLIDAY
    OFF_DAY
}

model Organization {
    id        String             @id @default(uuid())
    code      String             @unique
    name      String
    taxCode   String?            @unique
    phone     String?
    email     String?            @unique
    // logoMediaId String?
    website   String?
    timezone  String             @default("Asia/Ho_Chi_Minh")
    currency  String             @default("VND")
    status    OrganizationStatus @default(ACTIVE)
    createdAt DateTime           @default(now())
    updatedAt DateTime           @updatedAt
    deletedAt DateTime?
    // @@index([createdAt])
    // @@index([deletedAt])

    branches Branch[]

    @@index([status])
}

model Branch {
    id             String       @id @default(uuid())
    organizationId String
    code           String
    name           String
    phone          String?
    email          String?
    taxCode        String?
    address        String
    latitude       Decimal?
    longitude      Decimal?
    openTime       String?
    closeTime      String?
    timezone       String       @default("Asia/Ho_Chi_Minh")
    status         BranchStatus @default(ACTIVE)
    createdAt      DateTime     @default(now())
    updatedAt      DateTime     @updatedAt
    deletedAt      DateTime?

    organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
    departments  Department[]
    employees    Employee[]
    shifts       Shift[]

    @@unique([organizationId, code])
}

model Department {
    id          String           @id @default(uuid())
    branchId    String
    code        String
    name        String
    description String?
    status      DepartmentStatus @default(ACTIVE)
    createdAt   DateTime         @default(now())
    updatedAt   DateTime         @updatedAt
    deletedAt   DateTime?

    branch    Branch     @relation(fields: [branchId], references: [id], onDelete: Restrict)
    positions Position[]
    employees Employee[]

    @@unique([branchId, code])
}

model Position {
    id           String         @id @default(uuid())
    departmentId String
    code         String
    name         String
    level        Int
    description  String?
    status       PositionStatus @default(ACTIVE)
    createdAt    DateTime       @default(now())
    updatedAt    DateTime       @updatedAt
    deletedAt    DateTime?

    department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
    employees  Employee[]

    @@unique([departmentId, code])
}

model Employee {
    id              String         @id @default(uuid())
    branchId        String
    departmentId    String
    positionId      String
    managerId       String?
    employeeCode    String
    firstName       String
    lastName        String
    fullName        String
    email           String?        @unique
    phone           String?        @unique
    dateOfBirth     DateTime?      @db.Date
    hireDate        DateTime       @db.Date
    terminationDate DateTime?      @db.Date
    employmentType  EmploymentType
    status          EmployeeStatus @default(ACTIVE)
    createdAt       DateTime       @default(now())
    updatedAt       DateTime       @updatedAt
    deletedAt       DateTime?

    branch                   Branch            @relation(fields: [branchId], references: [id], onDelete: Restrict)
    position                 Position          @relation(fields: [positionId], references: [id], onDelete: Restrict)
    department               Department        @relation(fields: [departmentId], references: [id], onDelete: Restrict)
    manager                  Employee?         @relation("EmployeeManager", fields: [managerId], references: [id])
    subordinates             Employee[]        @relation("EmployeeManager")
    user                     User?
    shiftAssignments         ShiftAssignment[] @relation("EmployeeShiftAssignment")
    assignedShiftAssignments ShiftAssignment[] @relation("AssignedByEmployee")
    attendances              Attendance[]

    @@unique([branchId, employeeCode])
    @@index([departmentId])
    @@index([positionId])
    @@index([managerId])
    @@index([status])
}

model User {
    id                String     @id @default(uuid())
    employeeId        String     @unique
    username          String     @unique
    email             String     @unique
    passwordHash      String
    failedLoginCount  Int        @default(0)
    lastLoginAt       DateTime?
    passwordChangedAt DateTime?
    lockedUntil       DateTime?
    status            UserStatus @default(PENDING_ACTIVATION)
    createdAt         DateTime   @default(now())
    updatedAt         DateTime   @updatedAt
    deletedAt         DateTime?

    employee                      Employee                 @relation(fields: [employeeId], references: [id], onDelete: Restrict)
    userRoles                     UserRole[]               @relation("UserRoles")
    assignedRoles                 UserRole[]               @relation("AssignedUserRoles")
    revokedRoles                  UserRole[]               @relation("RevokedUserRoles")
    assignedPermission            RolePermission[]         @relation("AssignedRolePermissions")
    revokedPermission             RolePermission[]         @relation("RevokedRolePermissions")
    refreshTokens                 RefreshToken[]           @relation("UserRefreshToken")
    revokeRefreshTokens           RefreshToken[]           @relation("RevokedRefreshTokenUser")
    loginHistories                LoginHistory[]
    passwordResetTokens           PasswordResetToken[]
    revokedPasswordReset          PasswordResetToken[]     @relation("RevokedPasswordResetTokenUser")
    emailVerificationTokens       EmailVerificationToken[]
    revokedEmailVerificationToken EmailVerificationToken[] @relation("RevokedEmailVerificationTokens")

    @@index([status])
    @@index([lastLoginAt])
}

model Role {
    id              String           @id @default(uuid())
    code            String           @unique
    name            String
    description     String?
    isSystem        Boolean          @default(false)
    status          RoleStatus       @default(ACTIVE)
    createdAt       DateTime         @default(now())
    updatedAt       DateTime         @updatedAt
    deletedAt       DateTime?
    userRoles       UserRole[]
    userPermissions RolePermission[]

    @@index([status])
}

model Permission {
    id              String           @id @default(uuid())
    code            String           @unique
    permissionGroup String
    module          String
    action          String
    name            String
    description     String?
    isSystem        Boolean          @default(false)
    status          PermissionStatus @default(ACTIVE)
    createdAt       DateTime         @default(now())
    updatedAt       DateTime         @updatedAt
    deletedAt       DateTime?
    userPermissions RolePermission[]

    @@unique([module, action])
    @@index([permissionGroup])
    @@index([status])
    @@index([module])
}

model UserRole {
    id         String         @id @default(uuid())
    userId     String
    roleId     String
    assignedBy String?
    assignedAt DateTime       @default(now())
    expiredAt  DateTime?
    reason     String?
    status     UserRoleStatus @default(ACTIVE)
    revokedAt  DateTime?
    revokedBy  String?
    createdAt  DateTime       @default(now())
    updatedAt  DateTime       @updatedAt
    deletedAt  DateTime?

    user           User  @relation("UserRoles", fields: [userId], references: [id], onDelete: Restrict)
    role           Role  @relation(fields: [roleId], references: [id], onDelete: Restrict)
    assignedByUser User? @relation("AssignedUserRoles", fields: [assignedBy], references: [id])
    revokedByUser  User? @relation("RevokedUserRoles", fields: [revokedBy], references: [id])

    @@index([userId])
    @@index([roleId])
    @@index([status])
    @@index([assignedBy])
    @@index([revokedBy])
    @@index([expiredAt])
}

model RolePermission {
    id           String               @id @default(uuid())
    roleId       String
    permissionId String
    assignedAt   DateTime             @default(now())
    assignedBy   String?
    revokedAt    DateTime?
    revokedBy    String?
    reason       String?
    status       RolePermissionStatus @default(ACTIVE)
    createdAt    DateTime             @default(now())
    updatedAt    DateTime             @updatedAt
    deletedAt    DateTime?

    role           Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
    permission     Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)
    assignedByUser User?      @relation("AssignedRolePermissions", fields: [assignedBy], references: [id])
    revokedByUser  User?      @relation("RevokedRolePermissions", fields: [revokedBy], references: [id])

    @@index([roleId])
    @@index([permissionId])
    @@index([status])
    @@index([assignedBy])
    @@index([revokedBy])
}

model RefreshToken {
    id            String    @id @default(uuid())
    userId        String
    tokenHash     String    @unique
    deviceId      String?
    deviceName    String?
    ipAddress     String?
    userAgent     String?
    expiresAt     DateTime
    revokedAt     DateTime?
    revokedBy     String?
    revokedReason String?
    createdAt     DateTime  @default(now())
    updatedAt     DateTime  @updatedAt

    user          User  @relation("UserRefreshToken", fields: [userId], references: [id], onDelete: Restrict)
    revokedByUser User? @relation("RevokedRefreshTokenUser", fields: [revokedBy], references: [id], onDelete: Restrict)

    @@index([userId])
    @@index([expiresAt])
}

model LoginHistory {
    id           String    @id @default(uuid())
    userId       String?
    username     String
    loginType    LoginType
    success      Boolean
    failedReason String?
    ipAddress    String?
    userAgent    String?
    deviceId     String?
    deviceName   String?
    createdAt    DateTime  @default(now())

    user User? @relation(fields: [userId], references: [id], onDelete: Restrict)

    @@index([userId])
    @@index([createdAt])
    @@index([success])
}

model PasswordResetToken {
    id            String    @id @default(uuid())
    userId        String
    tokenHash     String    @unique
    expiresAt     DateTime
    usedAt        DateTime?
    revokedAt     DateTime?
    revokedBy     String?
    revokedReason String?
    createdAt     DateTime  @default(now())

    user          User  @relation(fields: [userId], references: [id], onDelete: Restrict)
    revokedByUser User? @relation("RevokedPasswordResetTokenUser", fields: [revokedBy], references: [id], onDelete: Restrict)

    @@index([userId])
    @@index([expiresAt])
}

model EmailVerificationToken {
    id            String    @id @default(uuid())
    userId        String
    email         String
    tokenHash     String    @unique
    expiresAt     DateTime
    usedAt        DateTime?
    revokedAt     DateTime?
    revokedBy     String?
    revokedReason String?
    createdAt     DateTime  @default(now())

    user          User  @relation(fields: [userId], references: [id], onDelete: Restrict)
    revokedByUser User? @relation("RevokedEmailVerificationTokens", fields: [revokedBy], references: [id], onDelete: Restrict)

    @@index([userId])
    @@index([expiresAt])
}

model Shift {
    id                     String      @id @default(uuid())
    branchId               String
    code                   String
    name                   String
    startTime              String
    endTime                String
    breakMinutes           Int
    lateGraceMinutes       Int
    earlyLeaveGraceMinutes Int
    isCrossDay             Boolean     @default(false)
    description            String?
    status                 ShiftStatus @default(ACTIVE)
    createdAt              DateTime    @default(now())
    updatedAt              DateTime    @updatedAt
    deletedAt              DateTime?

    branch           Branch            @relation(fields: [branchId], references: [id], onDelete: Restrict)
    shiftAssignments ShiftAssignment[]

    @@unique([branchId, code])
    @@index([status])
}

model ShiftAssignment {
    id          String                @id @default(uuid())
    employeeId  String
    shiftId     String
    workingDate DateTime              @db.Date
    assignedBy  String?
    note        String?
    status      ShiftAssignmentStatus @default(ACTIVE)
    createdAt   DateTime              @default(now())
    updatedAt   DateTime              @updatedAt
    deletedAt   DateTime?

    shift              Shift        @relation(fields: [shiftId], references: [id], onDelete: Restrict)
    employee           Employee     @relation("EmployeeShiftAssignment", fields: [employeeId], references: [id], onDelete: Restrict)
    assignedByEmployee Employee?    @relation("AssignedByEmployee", fields: [assignedBy], references: [id], onDelete: Restrict)
    attendances        Attendance[]

    @@unique([employeeId, workingDate, shiftId])
    @@index([status])
    @@index([assignedBy])
    @@index([workingDate])
}

model Attendance {
    id                String           @id @default(uuid())
    shiftAssignmentId String
    employeeId        String
    checkInAt         DateTime?
    checkOutAt        DateTime?
    checkInMethod     String?
    checkOutMethod    String?
    checkInIp         String?
    checkOutIp        String?
    checkInLatitude   Decimal?
    checkInLongitude  Decimal?
    checkOutLatitude  Decimal?
    checkOutLongitude Decimal?
    workedMinutes     Int              @default(0)
    workingDate       DateTime         @db.Date
    lateMinutes       Int              @default(0)
    earlyLeaveMinutes Int              @default(0)
    overtimeMinutes   Int              @default(0)
    attendanceStatus  AttendanceStatus @default(PRESENT)
    createdAt         DateTime         @default(now())
    updatedAt         DateTime         @updatedAt
    deletedAt         DateTime?

    shiftAssignment ShiftAssignment @relation(fields: [shiftAssignmentId], references: [id], onDelete: Restrict)
    employee       Employee        @relation(fields: [employeeId], references: [id], onDelete: Restrict)

    @@unique([shiftAssignmentId])
    @@index([workingDate])
    @@index([attendanceStatus])
    @@index([employeeId])
    @@index([employeeId, workingDate])
}
